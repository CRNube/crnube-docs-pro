<?xml version="1.0"?>
<ruleset name="CRNube Docs Pro">
    <description>WordPress security and API rules, PHP 8.1+ compatibility. Formatting follows the CRNube house style (4 spaces, PSR-4 file names), so the WordPress whitespace and file-name rules are left out.</description>

    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>
    <exclude-pattern>/assets/*</exclude-pattern>
    <exclude-pattern>/bin/*</exclude-pattern>
    <exclude-pattern>/tests/*</exclude-pattern>
    <exclude-pattern>/languages/*</exclude-pattern>
    <exclude-pattern>/build/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="testVersion" value="8.1-"/>
    <config name="minimum_wp_version" value="6.5"/>

    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB"/>
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="edit_crnd_documents"/>
                <element value="manage_crnd_categories"/>
                <element value="manage_crnd_settings"/>
                <element value="publish_crnd_documents"/>
                <element value="manage_crnd_access"/>
                <element value="view_crnd_reports"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.WP">
        <exclude name="WordPress.WP.AlternativeFunctions.file_get_contents_file_get_contents"/>
    </rule>
    <rule ref="WordPress.PHP">
        <exclude name="WordPress.PHP.YodaConditions"/>
        <exclude name="WordPress.PHP.POSIXFunctions"/>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="crnd"/>
                <element value="CRNube\DocsPro"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="crnube-docs-pro"/>
            </property>
        </properties>
    </rule>
    <rule ref="PHPCompatibilityWP"/>
</ruleset>
